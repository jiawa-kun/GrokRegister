# Web UI 暴露端口
WEB_PORT=6657

# Web 控制台初始账号默认是 admin；初始密码见 GRA_INITIAL_PASSWORD 或首次启动日志 / auth-bootstrap.json
# 首次登录后 WebUI 会强制修改账号密码

# 注册轮数
RUN_COUNT=10

# 邮件后端（兼容 dreamhunter2333/cloudflare_temp_email）
# MAIL_API_BASE：cloudflare_temp_email 后端 Worker/API 根地址，例如 https://mail-api.example.com
# MAIL_ADMIN_AUTH：cloudflare_temp_email 网站 admin 密码，用于 x-admin-auth
# MAIL_DOMAIN：cloudflare_temp_email 中已配置并可收信的域名，例如 example.com
MAIL_API_BASE=
MAIL_ADMIN_AUTH=
MAIL_DOMAIN=

# 可选代理
HTTP_PROXY=
BROWSER_PROXY=

# 使用 HTTPS 反向代理访问时可设为 1；直接 http://IP:6657 部署请留空
COOKIE_SECURE=

# Web 控制台初始密码；不填则首次启动自动生成并写入 /data/auth-bootstrap.json
GRA_INITIAL_PASSWORD=

# 敏感配置与账号凭据加密密钥；建议生产环境必填
GRA_MASTER_KEY=
