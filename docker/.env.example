# Web UI 暴露端口
WEB_PORT=6657

# Web 控制台初始账号默认是 admin；初始密码见 GRA_INITIAL_PASSWORD 或首次启动日志 / auth-bootstrap.json
# 首次登录后 WebUI 会强制修改账号密码

# 注册轮数
RUN_COUNT=10

# 邮件后端（兼容 dreamhunter2333/cloudflare_temp_email）
# MAIL_API_BASE：cloudflare_temp_email 后端 Worker/API 根地址，例如 https://mail-api.example.com
# MAIL_ADMIN_AUTH：cloudflare_temp_email 网站 admin 密码，用于 x-admin-auth
# MAIL_DOMAIN：cloudflare_temp_email 中已配置并可收信的域名，例如 example.com
MAIL_API_BASE=
MAIL_ADMIN_AUTH=
MAIL_DOMAIN=

# 可选代理
HTTP_PROXY=
BROWSER_PROXY=

# 生产镜像地址（配合根目录 docker-compose.yml 的 pull/update 流程）
GRA_IMAGE=ghcr.io/garrenkun/grokregister:latest
TURNSTILE_SOLVER_IMAGE=ghcr.io/garrenkun/grok-turnstile-solver:latest

# 使用 HTTPS 反向代理访问时可设为 1；直接 http://IP:6657 部署请留空
COOKIE_SECURE=

# Web 控制台初始密码；不填则首次启动自动生成并写入 docker/data/auth-bootstrap.json
GRA_INITIAL_PASSWORD=

# 敏感配置与账号凭据加密密钥；本地 compose 已强制要求。
# 推荐用 .\scripts\deploy-local-docker.ps1 自动生成；手动生成可用：
# powershell -NoProfile -Command "$b=New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)"
# 已有明文 config.json/accounts.json 会在设置该值后自动重写为加密格式。
GRA_MASTER_KEY=
